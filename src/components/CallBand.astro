---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Something leaking, clogged or not heating?',
  text = 'Call the office and we’ll get a technician scheduled as quickly as we can.',
} = Astro.props;
---
<section class="band">
  <div class="wrap band__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="band__phone" href={site.phoneHref}>
      <span class="band__icon"><Icon name="phone" /></span>
      <span>
        <span class="band__label">Give us a call</span>
        <span class="band__num">{site.phone}</span>
      </span>
    </a>
  </div>
</section>

<style>
  .band {
    background: var(--violet-600);
    color: var(--on-dark);
    padding-block: clamp(40px, 6vw, 64px);
    border-top: 6px solid var(--sky-300);
  }
  .band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .band h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    margin-bottom: 0.3em;
    max-width: 22ch;
  }
  .band p {
    margin: 0;
    font-size: 1.1rem;
    max-width: 52ch;
    color: #e4dcf2;
  }
  .band__phone {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--navy-900);
    color: var(--cloud);
    text-decoration: none;
    padding: 0.9rem 1.5rem 0.9rem 0.9rem;
    border-radius: var(--radius);
    border: 2px solid #0b1040;
    box-shadow: 0 4px 0 #0b1040;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .band__phone:hover {
    transform: translateY(2px);
    box-shadow: 0 2px 0 #0b1040;
  }
  .band__icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--cloud);
    color: var(--violet-600);
    display: grid;
    place-items: center;
  }
  .band__icon :global(svg) {
    width: 26px;
    height: 26px;
  }
  .band__label {
    display: block;
    font-family: var(--font-hand);
    font-size: 1.35rem;
    line-height: 1;
    color: var(--cloud);
  }
  .band__num {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 3vw, 2rem);
    line-height: 1.1;
  }
</style>
